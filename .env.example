# PostgreSQL credentials for docker-compose.
# Copy this file to .env and change the values: cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=warehouse

# JWT signing key for the backend (Jwt:Key). Use a long random string in production.
JWT_KEY=change-me-to-a-long-random-string

# Password for the seeded admin user (login: admin). Applied only when no users exist yet.
ADMIN_PASSWORD=change-me
